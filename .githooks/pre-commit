#!/bin/sh
# ── Aviso de sesión en paralelo (24-ago-2026) ────────────────────────────────
# El estudio se edita desde 2 operadores (Windows + Mac) y a menudo varias
# sesiones de Claude Code a la vez sobre el mismo repo. Sin esto, la primera
# señal de colisión era un commit mal atribuido o un fichero "perdido" — ya
# documentado 6+ veces en memoria (feedback_sesiones_claude_paralelas_mismo_repo,
# feedback_shared_repo_branch_collision). Solo avisa, nunca bloquea: un
# commit real no debe pararse por esto. Va ANTES del sellado de abajo para que
# el aviso salga aunque el sellado luego pare el commit por su cuenta.
rama=$(git branch --show-current 2>/dev/null)
if [ -n "$rama" ]; then
  git fetch --quiet origin "$rama" 2>/dev/null || true
  upstream="origin/$rama"
  if git rev-parse --verify --quiet "$upstream" >/dev/null 2>&1; then
    detras=$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
    if [ "$detras" -gt 0 ] 2>/dev/null; then
      echo "[pre-commit] AVISO: '$rama' va $detras commit(s) por detras de $upstream"
      echo "[pre-commit]        Puede haber otra sesion trabajando aqui — revisa 'git log $upstream' antes de seguir."
    fi
  fi
  echo "[pre-commit] rama activa: $rama"
fi

# Auto cache-busting: si cambia cualquier JS/CSS de assets/, sube ?v= en las páginas
# para que el CDN de Hostinger (hcdn, 7 días) sirva la versión fresca.
#
# Genérico a propósito. Antes había una lista a mano (lawang-card, portfolio-app) que
# nunca incluyó consent.js: el 29-jul-2026 el píxel de Meta se desplegó correctamente
# y el CDN siguió sirviendo el fichero viejo, así que NO se ejecutaba en ningún
# visitante. Un `curl` al fichero devolvía la versión nueva y engañaba; solo se vio
# abriéndolo en un navegador. Una lista que hay que acordarse de ampliar no es un
# guardrail. Si añades un asset nuevo, esto ya lo cubre — pero su etiqueta en el HTML
# tiene que llevar `?v=` desde el primer día, porque el sed solo sustituye lo que existe.
# ── DOS MECANISMOS, Y NO SE PISAN (aclarado el 6-ago-2026) ───────────────────
# `^assets/` (anclado) es a proposito: son los assets de la WEB PUBLICA, y se
# sellan con marca de tiempo aqui abajo. Los de la SUITE viven en
# `contracts/assets/` y los sella `tools/sella_assets.py` con el HASH del
# contenido, que es idempotente (no ensucia el diff en cada commit) y es lo que
# comprueba el gate de deploy.
# Ese dia se "arreglo" el ancla para cubrir los dos, y el resultado fue que el
# hook escribia una marca de tiempo encima del hash y el gate bloqueaba el push
# siguiente: dos guardrails peleandose. El ancla no era el bug — el bug era que
# nadie ejecutaba el sellador solo. Se hace justo debajo.
suite=$(git diff --cached --name-only | grep -E '^contracts/assets/.+\.(js|css)$' | grep -v '\.test\.js$' || true)
if [ -n "$suite" ]; then
  raiz=$(git rev-parse --show-toplevel)

  # EL PAQUETE DE CSS, ANTES DE SELLAR (27-ago-2026). `lawang.css` se genera
  # uniendo brand+topbar+suite+app, y las 21 paginas lo piden con `?v=<hash>`.
  # Si se sella ANTES de regenerarlo, el hash corresponde al paquete viejo: las
  # paginas creerian estar al dia y servirian el CSS anterior, que es peor que
  # no sellar — un fallo que no se ve porque todo parece correcto. El orden de
  # estas dos llamadas ES la garantia.
  empcss="$raiz/../../tools/empaqueta_css.py"
  if [ -f "$empcss" ]; then
    py=$(command -v python || command -v python3)
    "$py" "$empcss" >/dev/null 2>&1 || true
    git add contracts/assets/lawang.css 2>/dev/null || true
  fi

  # CSS QUE NO CASA CON NADA (27-ago-2026). El recuadro sobre el menú lateral
  # que el owner reportó era `.topbar{position:fixed}` con el header renombrado
  # a `lw-topbar`: un selector huérfano, en OCHO herramientas, y en tres de
  # ellas la regla de al lado compensaba por él. Una regla muerta no falla ni
  # pinta nada — solo la encuentra quien la busca, así que se busca aquí.
  # AVISA, no bloquea: la herramienta perdona prefijos dinámicos por diseño y
  # prefiero un aviso que se lee a un bloqueo que se saltaría con --no-verify.
  # MÁRGENES DE MÓVIL (27-ago-2026). El owner lo ha pedido DOS veces, y una
  # regla escrita que falla por segunda vez se promociona a comprobador. La
  # norma —16 px y ahí para, más `env(safe-area-inset)`— llevaba escrita desde
  # el 26-ago y aun así ninguna herramienta viva usaba el inset.
  margenes="$raiz/../../tools/margenes_movil.py"
  if [ -f "$margenes" ]; then
    py=$(command -v python || command -v python3)
    "$py" "$margenes" 2>/dev/null | head -14
  fi

  # IMPRESIÓN (27-ago-2026). El owner: «muy grave, al intentar imprimir un pdf
  # se ve el menu». Nunca hubo una regla que lo impidiera: el riel se ocultaba
  # por casualidad, porque un A4 mide menos de 860px y le entraba el bloque de
  # móvil. Al acotar ese bloque a `screen and` —necesario, un recibí salía en
  # blanco— se destapó. La casualidad no es un guardrail; esto sí.
  imprime="$raiz/../../tools/imprime_limpio.py"
  if [ -f "$imprime" ]; then
    py=$(command -v python || command -v python3)
    "$py" "$imprime" 2>/dev/null | head -16
  fi

  muerto="$raiz/../../tools/css_muerto.py"
  if [ -f "$muerto" ]; then
    py=$(command -v python || command -v python3)
    "$py" "$muerto" 2>/dev/null | head -20
  fi

  sellador="$raiz/../../tools/sella_assets.py"
  if [ -f "$sellador" ]; then
    py=$(command -v python || command -v python3)
    "$py" "$sellador" >/dev/null 2>&1 || true
    # re-stagear SOLO las paginas que el sellador haya tocado
    for f in $(git diff --name-only -- '*.html' '*.php'); do git add "$f"; done
    echo "[pre-commit] assets de la suite sellados por hash (sella_assets.py)"
  else
    echo "[pre-commit] AVISO: no encuentro sella_assets.py — sella a mano antes de pushear"
  fi
fi

# ── El paquete que la edge de firma lleva dentro ────────────────────────────────
# `firma-submit` pintaba la factura automatica bajandose cinco .js del sitio y
# ejecutandolos con `new Function`, teniendo la service_role en memoria (auditoria
# 17-ago, hallazgo 01). Ahora el codigo viaja DENTRO, en compartidos.generated.ts.
# Se regenera aqui en vez de exigir que alguien se acuerde, por el mismo motivo que
# el sellador de arriba: una copia que hay que actualizar a mano se queda vieja, y
# aqui quedarse vieja significa emitir facturas con un maquetador de hace semanas.
paquete=$(git diff --cached --name-only | grep -E '^(contracts/assets/(dinero|vocabulario|entities)\.js|facturas/(totales|compradores|documento)\.js|vencimientos/logica\.js)$' || true)
if [ -n "$paquete" ]; then
  raiz=$(git rev-parse --show-toplevel)
  empaquetador="$raiz/../../tools/empaqueta_edge.py"
  if [ -f "$empaquetador" ]; then
    py=$(command -v python || command -v python3)
    "$py" "$empaquetador" >/dev/null 2>&1 || true
    git add contracts/edge/firma-submit/compartidos.generated.ts contracts/edge/factura-vencimiento/compartidos.generated.ts 2>/dev/null || true
    echo "[pre-commit] paquete de la edge de firma regenerado (empaqueta_edge.py)"
    echo "[pre-commit] ⚠️  REDESPLIEGA firma-submit y factura-vencimiento: el repo ya lo tiene, produccion no"
  else
    echo "[pre-commit] AVISO: no encuentro empaqueta_edge.py — la edge se queda con el paquete viejo"
  fi
fi

changed=$(git diff --cached --name-only | grep -E '^assets/.+\.(js|css)$' || true)
[ -z "$changed" ] && exit 0
ver=$(date +%Y%m%d%H%M%S)
# La lista de PAGINAS era el mismo bug que la de assets: index/thecollection/legal a mano,
# y la landing /modelo/<id> (30-jul) habria quedado fuera sin que nadie lo notara. Ahora
# se descubren solas — pero SOLO las que referencian el asset que ha cambiado. Refrescar
# las 9 que llevan cualquier ?v= metia en el commit ediciones a medias de la suite interna
# (usuarios/, unidades/, operaciones/): un `git add` que el autor no pidio.
# ── 21-ago-2026: el sellado lo hace PYTHON, no `sed` ─────────────────────────
# Esto llevaba roto en macOS sin que nadie lo supiera. `sed -i -E` en BSD no es
# lo mismo que en GNU: `-i` se come el `-E` como sufijo de copia de seguridad, el
# patron pasa a leerse como BRE, los parentesis dejan de agrupar y sale
# «\1 not defined in the RE». El bucle seguia, hacia `git add` del fichero sin
# tocar y la linea final imprimia «aplicado a N pagina(s)». Un guardrail que
# informa de exito mientras no hace nada — que es peor que no tenerlo, porque el
# mensaje verde convence de que el asset se ha sellado.
# Se vio el 21-ago al cambiar assets/portfolio-app.js: la pagina seguia pidiendo
# el sello del 12-ago, o sea que el CDN (hcdn, 7 dias) habria servido el fichero
# viejo a todos los visitantes durante una semana. Exactamente el fallo del pixel
# de Meta del 29-jul que este hook se escribio para evitar.
# Python porque ya es la herramienta del estudio y se comporta igual en las dos
# plataformas. Y si NO puede sellar, el commit se para: un asset sin sellar no es
# un aviso, es codigo que no llega a produccion.
raiz=$(git rev-parse --show-toplevel)
py=$(command -v python3 || command -v python)
"$py" - "$ver" $changed <<'PYSELLA' || exit 1
import os, re, subprocess, sys
ver, cambiados = sys.argv[1], sys.argv[2:]
nombres = sorted({os.path.basename(c) for c in cambiados})
pat = re.compile(r"(assets/(?:%s))\?v=[0-9A-Za-z._-]+" % "|".join(re.escape(n) for n in nombres))
paginas = subprocess.run(["git", "ls-files", "*.html", "*.php"],
                         capture_output=True, text=True).stdout.split()
tocadas = []
for f in paginas:
    try:
        txt = open(f, encoding="utf8").read()
    except (OSError, UnicodeDecodeError):
        continue
    nuevo, n = pat.subn(lambda m: m.group(1) + "?v=" + ver, txt)
    if n:
        open(f, "w", encoding="utf8").write(nuevo)
        subprocess.run(["git", "add", f], check=True)
        tocadas.append((f, n))
if not tocadas:
    # Un asset que ha cambiado y que NINGUNA pagina pide con ?v= no se puede
    # sellar: el navegador lo seguira sirviendo de cache. Se para el commit —
    # el comentario de arriba lo dice desde el primer dia («su etiqueta tiene
    # que llevar ?v= desde el primer dia»), pero hasta hoy nadie lo comprobaba.
    print("[pre-commit] ⛔ %s ha cambiado y ninguna pagina lo pide con ?v=." % ", ".join(nombres))
    print("[pre-commit]    Anade ?v= a su <script>/<link> o el CDN servira lo viejo.")
    sys.exit(1)
print("[pre-commit] cache-bust ?v=%s aplicado a %d pagina(s): %s"
      % (ver, len(tocadas), ", ".join(f for f, _ in tocadas)))
PYSELLA
exit 0
