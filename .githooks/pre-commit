#!/bin/sh
# Auto cache-busting: si cambia cualquier JS/CSS de assets/, sube ?v= en las páginas
# para que el CDN de Hostinger (hcdn, 7 días) sirva la versión fresca.
#
# Genérico a propósito. Antes había una lista a mano (lawang-card, portfolio-app) que
# nunca incluyó consent.js: el 29-jul-2026 el píxel de Meta se desplegó correctamente
# y el CDN siguió sirviendo el fichero viejo, así que NO se ejecutaba en ningún
# visitante. Un `curl` al fichero devolvía la versión nueva y engañaba; solo se vio
# abriéndolo en un navegador. Una lista que hay que acordarse de ampliar no es un
# guardrail. Si añades un asset nuevo, esto ya lo cubre — pero su etiqueta en el HTML
# tiene que llevar `?v=` desde el primer día, porque el sed solo sustituye lo que existe.
changed=$(git diff --cached --name-only | grep -E '^assets/.+\.(js|css)$' || true)
[ -z "$changed" ] && exit 0
ver=$(date +%Y%m%d%H%M%S)
for f in index.html thecollection.html legal.html; do
  [ -f "$f" ] || continue
  sed -i -E "s#(assets/[A-Za-z0-9_.-]+\.(js|css))\?v=[0-9A-Za-z]+#\1?v=$ver#g" "$f"
  git add "$f"
done
echo "[pre-commit] cache-bust ?v=$ver aplicado a index/thecollection/legal"
exit 0
