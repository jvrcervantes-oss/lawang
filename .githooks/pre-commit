#!/bin/sh
# Auto cache-busting: si cambia cualquier JS/CSS de assets/, sube ?v= en las páginas
# para que el CDN de Hostinger (hcdn, 7 días) sirva la versión fresca.
#
# Genérico a propósito. Antes había una lista a mano (lawang-card, portfolio-app) que
# nunca incluyó consent.js: el 29-jul-2026 el píxel de Meta se desplegó correctamente
# y el CDN siguió sirviendo el fichero viejo, así que NO se ejecutaba en ningún
# visitante. Un `curl` al fichero devolvía la versión nueva y engañaba; solo se vio
# abriéndolo en un navegador. Una lista que hay que acordarse de ampliar no es un
# guardrail. Si añades un asset nuevo, esto ya lo cubre — pero su etiqueta en el HTML
# tiene que llevar `?v=` desde el primer día, porque el sed solo sustituye lo que existe.
# ── DOS MECANISMOS, Y NO SE PISAN (aclarado el 6-ago-2026) ───────────────────
# `^assets/` (anclado) es a proposito: son los assets de la WEB PUBLICA, y se
# sellan con marca de tiempo aqui abajo. Los de la SUITE viven en
# `contracts/assets/` y los sella `tools/sella_assets.py` con el HASH del
# contenido, que es idempotente (no ensucia el diff en cada commit) y es lo que
# comprueba el gate de deploy.
# Ese dia se "arreglo" el ancla para cubrir los dos, y el resultado fue que el
# hook escribia una marca de tiempo encima del hash y el gate bloqueaba el push
# siguiente: dos guardrails peleandose. El ancla no era el bug — el bug era que
# nadie ejecutaba el sellador solo. Se hace justo debajo.
suite=$(git diff --cached --name-only | grep -E '^contracts/assets/.+\.(js|css)$' | grep -v '\.test\.js$' || true)
if [ -n "$suite" ]; then
  raiz=$(git rev-parse --show-toplevel)
  sellador="$raiz/../../tools/sella_assets.py"
  if [ -f "$sellador" ]; then
    py=$(command -v python || command -v python3)
    "$py" "$sellador" >/dev/null 2>&1 || true
    # re-stagear SOLO las paginas que el sellador haya tocado
    for f in $(git diff --name-only -- '*.html' '*.php'); do git add "$f"; done
    echo "[pre-commit] assets de la suite sellados por hash (sella_assets.py)"
  else
    echo "[pre-commit] AVISO: no encuentro sella_assets.py — sella a mano antes de pushear"
  fi
fi

changed=$(git diff --cached --name-only | grep -E '^assets/.+\.(js|css)$' || true)
[ -z "$changed" ] && exit 0
ver=$(date +%Y%m%d%H%M%S)
# La lista de PAGINAS era el mismo bug que la de assets: index/thecollection/legal a mano,
# y la landing /modelo/<id> (30-jul) habria quedado fuera sin que nadie lo notara. Ahora
# se descubren solas — pero SOLO las que referencian el asset que ha cambiado. Refrescar
# las 9 que llevan cualquier ?v= metia en el commit ediciones a medias de la suite interna
# (usuarios/, unidades/, operaciones/): un `git add` que el autor no pidio.
# basename + el punto como [.] (literal, no comodin); varios assets van con |
pat=$(echo "$changed" | sed -E 's#.*/##' | sed 's#\.#[.]#g' | paste -sd'|' -)
n=0
for f in $(grep -rlE "assets/($pat)\?v=" $(git ls-files '*.html' '*.php') 2>/dev/null); do
  sed -i -E "s#(assets/($pat))\?v=[0-9A-Za-z]+#\1?v=$ver#g" "$f"
  git add "$f"
  n=$((n+1))
done
echo "[pre-commit] cache-bust ?v=$ver aplicado a $n pagina(s)"
exit 0
