#!/bin/sh
# ── Solo main (y suite-v4) salen al remoto (24-sep-2026) ─────────────────────
# Cada sesion de Claude trabaja en su worktree, en una rama `sesion/<id>` que es
# SUYA y nunca se publica: ahi vive trabajo a medias y lo que espera el OK del
# owner. Este repo es PUBLICO (github.com/jvrcervantes-oss/lawang): una rama de
# sesion empujada una sola vez queda en GitHub para siempre. «Solo en local» en
# prosa no frena nada; esto si. Versionado en .githooks/, asi que core.hooksPath
# lo lleva a cada worktree y al Mac sin paso manual.
# Encargo: encargos/20260924_estudio_worktree_por_sesion.md (hallazgo de Seguridad).
# Para publicar una rama nueva a proposito: añadirla aqui, con su porque.
permitidas="refs/heads/main refs/heads/suite-v4"
malo=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in refs/tags/*) continue ;; esac
  ok=0
  for p in $permitidas; do
    [ "$remote_ref" = "$p" ] && ok=1
  done
  if [ "$ok" -eq 0 ]; then
    echo "[pre-push] ⛔ '$remote_ref' no se publica: este repo es publico y solo salen main y suite-v4." >&2
    malo=1
  fi
done
if [ "$malo" -eq 1 ]; then
  echo "[pre-push]    Para llevar tu trabajo a produccion: python tools/aterriza.py <id>  (ids: python tools/sesion.py lista)" >&2
  exit 1
fi

# ── El navegador no escribe en la base (26-sep-2026) ──────────────────────────
# Norma del owner: contexto/patrones_tecnicos.md -> «Frontera frontend / backend» del
# estudio. El mismo trinquete corre en el gate de las sesiones de Claude; aqui cubre el
# push hecho a mano desde una terminal (o el Mac), que no pasa por ese gate. Busca
# tools/escrituras_front.py subiendo desde el repo, porque Lawang vive en
# proyectos/Lawang y en proyectos/_sesiones/<id>/Lawang segun quien empuje.
raiz=$(git rev-parse --show-toplevel)
dir="$raiz"
check=""
while [ "$dir" != "/" ] && [ -n "$dir" ] && [ "$dir" != "." ]; do
  if [ -f "$dir/tools/escrituras_front.py" ]; then check="$dir/tools/escrituras_front.py"; break; fi
  padre=$(dirname "$dir"); [ "$padre" = "$dir" ] && break; dir="$padre"
done
py=$(command -v python3 || command -v python)
if [ -z "$check" ] || [ -z "$py" ]; then
  # Sin el estudio al lado no hay con que medir. Se dice, no se calla: un check que no ha
  # podido mirar tiene que decirlo (departamentos/desarrollo/prompt.md).
  echo "[pre-push] ⚠ no se ha podido comprobar que el navegador no escriba en la base (falta tools/escrituras_front.py o python)." >&2
  exit 0
fi
if ! "$py" "$check" --gate --repo "$raiz" >&2; then
  echo "[pre-push] ⛔ push parado: hay escrituras NUEVAS a la base desde el navegador." >&2
  exit 1
fi
exit 0
