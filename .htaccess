# 28-jul-2026: /panel/ renombrado a /intranet/. 301 para los marcadores del equipo.
RedirectMatch 301 ^/panel(/.*)?$ /intranet$1
# ═══════════════════════════════════════════════════════════════════════════
# 26-ago-2026 · LA INTRANET ENTERA BAJO /intranet/
# ═══════════════════════════════════════════════════════════════════════════
# Decisión del owner: «si operaciones o facturas son parte de la intranet, por
# qué se entra desde /facturas/ y no desde /intranet/facturas/». Tiene razón por
# dos motivos, y el segundo es el que aprieta:
#   · la URL deja de mentir sobre qué es cada cosa;
#   · y sobre todo, una herramienta interna dejaba de ocupar un nombre del
#     espacio PÚBLICO. `lawangproperties.com/proyectos/` suena exactamente a
#     página de marketing, y cada herramienta nueva competía con la web del
#     cliente por su propia URL.
#
# NO se mueven, a propósito:
#   · /portal/  — es la cara del CLIENTE. Un comprador no tiene por qué ver
#     «intranet» en su barra, y hay enlaces ya enviados.
#   · /entrar/  — es la puerta, y desde ahí se elige equipo o cliente.
#   · /contracts/assets/ — la casa común de la suite. Son 318 referencias con el
#     sello `?v=` por hash en 20 páginas; moverlas es churn sin ganancia y el
#     riesgo es el fallo más caro que ha tenido esta suite (un hash que no
#     corresponde y el CDN sirviendo una versión vieja 7 días).
#
# 301 permanentes y no temporales: el mismo criterio que /panel/ y /unidades/ de
# aquí arriba. Un marcador del equipo o un enlace suelto en un correo de hace
# meses siguen llegando, y no hay que acordarse de retirar nada.
RedirectMatch 301 ^/(facturas|operaciones|compradores|proyectos|obra|documentacion|usuarios|vencimientos|creatividades|dossier)(/.*)?$ /intranet/$1$2

# 11-ago-2026: /unidades/ renombrado a /proyectos/ (mismo criterio de arriba).
# 26-ago: y /proyectos/ se fue bajo /intranet/. Se apunta DIRECTO al destino final
# en vez de encadenar dos 301: una cadena funciona, pero cada salto es un viaje mas
# y basta con que alguien copie el intermedio para volver a tener dos.
RedirectMatch 301 ^/unidades(/.*)?$ /intranet/proyectos$1
# 6-ago-2026: puerta unica /entrar/ (elige equipo o cliente). 301 para lo que
# tuviera enlazado o guardado /contracts/login.html.
Redirect 301 /contracts/login.html /entrar/

# private/ guarda estado de servidor (contadores del rate-limit del login y del
# formulario de leads). Nunca se sirve: son ficheros con IPs y marcas de tiempo.
RedirectMatch 404 (?i)/private/
RedirectMatch 404 (?i)/\.git

# Las herramientas .py del proyecto (build_seo.py, publicar_data.py) viajan en el repo pero
# el servidor no las ejecuta: las servia como text/plain, o sea el codigo fuente descargable
# por cualquiera. No hay secretos dentro, pero regala los endpoints internos y la logica.
RedirectMatch 404 (?i)\.py$

# Igual con los .sql, y por el mismo motivo — 24-ago-2026, verificado en produccion:
# https://lawangproperties.com/supabase/migrations/<fichero>.sql respondia 200 y
# servia el esquema entero de la base. `contracts/sql/` ya daba 403 por otra regla,
# asi que la carpeta que llego despues (supabase/migrations/, con las 160
# migraciones) entro sin cobertura: la lista a mano otra vez. Va por EXTENSION,
# no por carpeta, para que la proxima carpeta de .sql nazca cubierta.
# Lo pedia `contexto/seguridad_2026.md` §1 desde el principio («bloquear .md, .sql,
# .zip, .bak, .log»); esta era la mitad que faltaba.
RedirectMatch 404 (?i)\.sql$

# Piezas internas de la landing de modelo: datos y funciones, nunca una pagina.
# lib.php y modelos.php respondian 200 con cuerpo vacio.
RedirectMatch 404 (?i)/modelo/(lib|modelos)\.php$

# Arneses de prueba, en cualquier carpeta y por patron. Antes iban por nombre en la linea
# de arriba y el que llego despues (api/test_ghl.php) respondio 200 en produccion desde el
# primer despliegue: la lista a mano ERA el bug, igual que en el hook de cache-bust.
RedirectMatch 404 (?i)/test_[^/]+\.php$

# ...y el `RedirectMatch` de arriba NO basta: casa la URL, no el fichero, asi que un
# PATH_INFO detras de la extension se lo salta entero. Verificado en produccion el
# 3-ago-2026: /api/test_lead_ticket.php/x ejecuto el arnes, y /modelo/lib.php/x y
# /modelo/modelos.php/x devolvian 200 pese a la regla de la linea 16. `Files` casa el
# fichero YA resuelto, que es lo que de verdad se ejecuta, y aplica a las subcarpetas.
# Se deja tambien el RedirectMatch: da el 404 bonito en la ruta normal. Este es el cierre.
<FilesMatch "(?i)^(test_[^/]+|lib|modelos)\.php$">
  Order allow,deny
  Deny from all
</FilesMatch>

# URLs limpias en las paginas publicas: /thecollection, no /thecollection.html.
# Solo raiz y solo GET a proposito: las subcarpetas (api/, contracts/, facturas/, intranet/)
# son apps internas con logins y formularios, y un 301 convierte un POST en GET — ahi no se toca.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /portfolio.html: alias temporal hasta que exista la pagina de la promotora — ELIMINAR al crearla.
  # Va como RewriteRule y no como "Redirect" de mod_alias porque mod_rewrite corre ANTES:
  # con mod_alias, la regla 1 de abajo se lo comia y mandaba a /portfolio (404).
  RewriteRule ^portfolio\.html$ /thecollection [R=302,L,NE]

  # Sitemap dinamico: la URL de siempre (/sitemap.xml, la que ya conoce robots.txt) pasa a
  # servir sitemap.php, generado desde data.json — antes era un XML estatico con 5 URLs fijas
  # que nunca listaba ninguna propiedad. Rewrite interno, sin redirect: la URL no cambia.
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]

  # Ficha de propiedad con su query real (ej. si alguien pega /thecollection.php?property=x):
  # redirige a la URL limpia /property/x ANTES de la regla 1 de abajo. thecollection.php esta
  # en RAIZ (a diferencia de modelo/index.php, ver la 2b mas abajo), asi que sin esto la regla 1
  # lo cazaria primero y tiraria el ?property= entero, dejando /thecollection a secas.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+thecollection\.php\?property=([A-Za-z0-9-]+)" [NC]
  RewriteRule ^ /property/%1? [R=301,L,NE]

  # 1) La URL con extension redirige a la limpia: una sola URL indexable, sin contenido duplicado.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+index\.html[\s?]" [NC]
  RewriteRule ^ / [R=301,L,NE]

  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+([^/\s?]+?)\.(html|php)[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2) La URL limpia sirve el fichero real sin que el navegador vea la extension.
  #    ^([^/.]+)$ = solo raiz y sin puntos, asi data.json / robots.txt / assets no entran aqui.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/.]+)$ $1.html [L]
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/.]+)$ $1.php [L]

  # 2b) La landing de modelo, con su extension, tambien redirige a la URL limpia: la regla 1
  #     solo casa rutas de raiz, asi que /modelo/index.php?m=dali servia un duplicado con 200.
  #     La `?` final descarta la query original para no arrastrar ?m= a la URL limpia.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+modelo/index\.php\?m=([A-Za-z0-9-]+)" [NC]
  RewriteRule ^ /modelo/%1? [R=301,L,NE]

  # 3) Landings de modelo: /modelo/dali sirve modelo/index.php?m=dali. Va DESPUES de las
  #    reglas de raiz a proposito: aquellas solo casan rutas sin barra, asi que no se comen
  #    esta. Un modelo inexistente o sin renders lo manda index.php a /thecollection.
  RewriteRule ^modelo/([A-Za-z0-9-]+)/?$ /modelo/index.php?m=$1 [L,QSA]

  # 3b) Ficha de propiedad: /property/<slug> sirve thecollection.php?property=<slug> (mismo
  #     mecanismo que la 3 de arriba). A diferencia de modelo/index.php, thecollection.php
  #     decide 404 REAL si el slug no existe o no es visible — no hay redirect a /thecollection.
  RewriteRule ^property/([A-Za-z0-9-]+)/?$ /thecollection.php?property=$1 [L,QSA]
</IfModule>

# Cabeceras de seguridad. HSTS SIN includeSubDomains a proposito: hay subdominios
# (p.ej. sumbahills.lawangproperties.com) cuyo SSL no controlamos aqui; incluirlos podria
# forzar HTTPS y romperlos.
#
# 17-ago-2026 (auditoria): aqui decia "No se toca la CSP existente". NO HABIA
# NINGUNA — `grep Content-Security` sobre el proyecto entero daba cero. El
# comentario llevaba semanas dando el punto por cubierto, que es el fallo mas
# barato de cometer y de los mas caros de detectar: documentacion que miente.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # ── CSP, EN MODO INFORME ────────────────────────────────────────────────────
  # Entra como `Report-Only` a proposito: en ese modo el navegador NO bloquea
  # nada, solo escribe en la consola lo que HABRIA bloqueado. Es el unico modo en
  # que se puede estrenar una CSP sobre una suite que mueve contratos firmados sin
  # arriesgarse a dejarla inservible en el deploy de un viernes. Se mira la consola
  # unos dias en las pantallas que mas se usan (Contratos, Facturas, el portal del
  # comprador y la web publica), se ajusta lo que salga, y ENTONCES se cambia el
  # nombre de la cabecera a `Content-Security-Policy` para que empiece a bloquear.
  #
  # `unsafe-inline` en script-src NO es un descuido: esto es HTML estatico servido
  # por Hostinger, sin nonce por peticion, y la decision esta tomada por escrito en
  # `contexto/seguridad_2026.md`. El valor real de esta politica lo aportan las
  # otras cuatro directivas, que no dependen de eso:
  #   · frame-ancestors  — nadie puede meter la intranet en un iframe suyo;
  #   · base-uri         — un <base> inyectado no puede reescribir a donde van los
  #                        enlaces y los formularios relativos;
  #   · form-action      — un formulario no puede enviarse a un servidor ajeno;
  #                        aqui viven 46 pasaportes y los datos de 98 compradores;
  #   · connect-src      — el navegador solo puede hablar con Supabase, el servicio
  #                        de PDF y las APIs de la web. Es lo que convierte una
  #                        inyeccion de script en algo que no puede EXFILTRAR.
  #
  # Cada origen de esta lista se MIDIO en el repo, no se supuso:
  #   cdn.jsdelivr.net     supabase-js + iconos Phosphor
  #   cdnjs.cloudflare.com pdf.js Y SU WORKER (de ahi el worker-src)
  #   fonts.g*             Google Fonts (hoja + ficheros)
  #   *.supabase.co        REST, Auth, Storage y las Edge Functions
  #   railway.app          contracts-pdf-service, el que renderiza el PDF
  #   leadconnectorhq.com  GHL, solo desde los formularios de la web publica
  #   connect.facebook.net pixel de Meta (lo carga consent.js tras consentimiento)
  #   drive.google.com     iframes de vista previa de Documentacion
  #   data: y blob: en img/media: los anexos de contrato son imagenes en base64 y
  #                        los PDF firmados se abren como blob. Quitarlos rompe el
  #                        generador de contratos entero (ver hallazgo 02: eso es
  #                        justo lo que hay que sacar a Storage).
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://connect.facebook.net https://*.leadconnectorhq.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://images.unsplash.com https://*.supabase.co https://www.facebook.com; media-src 'self' data: blob:; connect-src 'self' https://*.supabase.co https://contracts-pdf-service-production.up.railway.app https://*.leadconnectorhq.com https://open.er-api.com https://connect.facebook.net https://www.facebook.com; frame-src 'self' https://drive.google.com https://*.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://*.leadconnectorhq.com; object-src 'none'"

  # Piezas COMPARTIDAS de la suite interna: el servidor las servia con
  # max-age=604800 (7 dias). El 29-jul eso dejo a los agentes con un guard.js
  # viejo que no entregaba la ficha de permisos: el panel de usuarios les decia
  # que no eran administradores aunque lo fueran, y el fallo no se ve en un
  # `curl` con ?v= (que trae el fichero real) sino solo en un navegador que ya
  # tenia el viejo. `no-cache` NO desactiva la cache: obliga a revalidar, asi
  # que si no ha cambiado sigue siendo un 304 barato.
  # 30-jul: SE QUITA LA LISTA A MANO. Era `^(guard|visor|topbar|totales|consent)`
  # y el fallo cayo tres veces seguidas, siempre en el fichero que faltaba en la
  # lista: guard.js (29-jul, agentes sin permisos), consent.js (29-jul, pixel de
  # Meta) y entities.js (30-jul, las facturas de PT San Dal Woods salian con el
  # logo de Lawang porque el navegador tenia la version sin el campo `logo`).
  # Una lista de nombres a mano ES el bug: el proximo fichero nuevo tampoco
  # estara. Ahora entra TODO el js/css del sitio.
  # Coste real: una revalidacion por fichero en visita repetida, que responde
  # 304 sin cuerpo. Las imagenes y los videos -- lo que de verdad pesa -- siguen
  # con su cache de 7 dias intacta.
  # HTML DE LA SUITE INTERNA -- 15-ago-2026.
  # El sellado `?v=<hash>` de los assets vive DENTRO del HTML: si el navegador
  # cachea la pagina, sirve referencias viejas y el sellado no sirve de nada. Es
  # la misma familia del incidente de guard.js (29-jul), un piso mas arriba. Paso
  # de verdad: el owner no veia el menu lateral nuevo porque su navegador le
  # servia un HTML sin la etiqueta del catalogo.
  #
  # Se acota por RUTA y no por nombre de fichero: un <FilesMatch "index.html">
  # habria casado tambien con el index.html PUBLICO de la raiz, y ahi cada visita
  # revalidaria sin motivo -- son paginas de marketing que cambian poco.
  # `no-cache` no desactiva la cache: obliga a revalidar, asi que si no ha
  # cambiado responde 304 sin cuerpo.
  # ⚠️ vencimientos añadido el 18-ago-2026 AL CREAR la herramienta, no despues de
  # cazar el fallo: esta lista es de las "a mano" que ya mordieron tres veces
  # (guard.js, consent.js, entities.js). Toda carpeta nueva de la suite entra
  # aqui EN LA MISMA TAREA que la crea, o su HTML se cachea 7 dias y el sellado
  # ?v= de dentro no sirve de nada.
  SetEnvIf Request_URI "^/(intranet|operaciones|vencimientos|facturas|compradores|proyectos|documentacion|obra|usuarios|creatividades|dossier|contracts|entrar|portal)/" LW_SUITE
  Header set Cache-Control "no-cache, must-revalidate" env=LW_SUITE
  Header unset Expires env=LW_SUITE

  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
    # el servidor emite ademas un Expires a 7 dias. Cache-Control manda sobre
    # Expires por norma, asi que no rompe nada, pero deja unas cabeceras que se
    # contradicen: quien diagnostique el proximo problema de cache las leera y
    # perdera el tiempo. Fuera.
    Header unset Expires
  </FilesMatch>
</IfModule>
