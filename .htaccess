# 28-jul-2026: /panel/ renombrado a /intranet/. 301 para los marcadores del equipo.
RedirectMatch 301 ^/panel(/.*)?$ /intranet$1
# 11-ago-2026: /unidades/ renombrado a /proyectos/ (mismo criterio de arriba).
RedirectMatch 301 ^/unidades(/.*)?$ /proyectos$1
# 6-ago-2026: puerta unica /entrar/ (elige equipo o cliente). 301 para lo que
# tuviera enlazado o guardado /contracts/login.html.
Redirect 301 /contracts/login.html /entrar/

# private/ guarda estado de servidor (contadores del rate-limit del login y del
# formulario de leads). Nunca se sirve: son ficheros con IPs y marcas de tiempo.
RedirectMatch 404 (?i)/private/
RedirectMatch 404 (?i)/\.git

# Las herramientas .py del proyecto (build_seo.py, publicar_data.py) viajan en el repo pero
# el servidor no las ejecuta: las servia como text/plain, o sea el codigo fuente descargable
# por cualquiera. No hay secretos dentro, pero regala los endpoints internos y la logica.
RedirectMatch 404 (?i)\.py$

# Piezas internas de la landing de modelo: datos y funciones, nunca una pagina.
# lib.php y modelos.php respondian 200 con cuerpo vacio.
RedirectMatch 404 (?i)/modelo/(lib|modelos)\.php$

# Arneses de prueba, en cualquier carpeta y por patron. Antes iban por nombre en la linea
# de arriba y el que llego despues (api/test_ghl.php) respondio 200 en produccion desde el
# primer despliegue: la lista a mano ERA el bug, igual que en el hook de cache-bust.
RedirectMatch 404 (?i)/test_[^/]+\.php$

# ...y el `RedirectMatch` de arriba NO basta: casa la URL, no el fichero, asi que un
# PATH_INFO detras de la extension se lo salta entero. Verificado en produccion el
# 3-ago-2026: /api/test_lead_ticket.php/x ejecuto el arnes, y /modelo/lib.php/x y
# /modelo/modelos.php/x devolvian 200 pese a la regla de la linea 16. `Files` casa el
# fichero YA resuelto, que es lo que de verdad se ejecuta, y aplica a las subcarpetas.
# Se deja tambien el RedirectMatch: da el 404 bonito en la ruta normal. Este es el cierre.
<FilesMatch "(?i)^(test_[^/]+|lib|modelos)\.php$">
  Order allow,deny
  Deny from all
</FilesMatch>

# URLs limpias en las paginas publicas: /thecollection, no /thecollection.html.
# Solo raiz y solo GET a proposito: las subcarpetas (api/, contracts/, facturas/, intranet/)
# son apps internas con logins y formularios, y un 301 convierte un POST en GET — ahi no se toca.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /portfolio.html: alias temporal hasta que exista la pagina de la promotora — ELIMINAR al crearla.
  # Va como RewriteRule y no como "Redirect" de mod_alias porque mod_rewrite corre ANTES:
  # con mod_alias, la regla 1 de abajo se lo comia y mandaba a /portfolio (404).
  RewriteRule ^portfolio\.html$ /thecollection [R=302,L,NE]

  # 1) La URL con extension redirige a la limpia: una sola URL indexable, sin contenido duplicado.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+index\.html[\s?]" [NC]
  RewriteRule ^ / [R=301,L,NE]

  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+([^/\s?]+?)\.(html|php)[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2) La URL limpia sirve el fichero real sin que el navegador vea la extension.
  #    ^([^/.]+)$ = solo raiz y sin puntos, asi data.json / robots.txt / assets no entran aqui.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/.]+)$ $1.html [L]
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/.]+)$ $1.php [L]

  # 2b) La landing de modelo, con su extension, tambien redirige a la URL limpia: la regla 1
  #     solo casa rutas de raiz, asi que /modelo/index.php?m=dali servia un duplicado con 200.
  #     La `?` final descarta la query original para no arrastrar ?m= a la URL limpia.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+modelo/index\.php\?m=([A-Za-z0-9-]+)" [NC]
  RewriteRule ^ /modelo/%1? [R=301,L,NE]

  # 3) Landings de modelo: /modelo/dali sirve modelo/index.php?m=dali. Va DESPUES de las
  #    reglas de raiz a proposito: aquellas solo casan rutas sin barra, asi que no se comen
  #    esta. Un modelo inexistente o sin renders lo manda index.php a /thecollection.
  RewriteRule ^modelo/([A-Za-z0-9-]+)/?$ /modelo/index.php?m=$1 [L,QSA]
</IfModule>

# Cabeceras de seguridad. HSTS SIN includeSubDomains a proposito: hay subdominios
# (p.ej. sumbahills.lawangproperties.com) cuyo SSL no controlamos aqui; incluirlos podria
# forzar HTTPS y romperlos. No se toca la CSP existente (la web tiene inline scripts/estilos;
# una CSP estricta necesitaria nonces y romperia paginas).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Piezas COMPARTIDAS de la suite interna: el servidor las servia con
  # max-age=604800 (7 dias). El 29-jul eso dejo a los agentes con un guard.js
  # viejo que no entregaba la ficha de permisos: el panel de usuarios les decia
  # que no eran administradores aunque lo fueran, y el fallo no se ve en un
  # `curl` con ?v= (que trae el fichero real) sino solo en un navegador que ya
  # tenia el viejo. `no-cache` NO desactiva la cache: obliga a revalidar, asi
  # que si no ha cambiado sigue siendo un 304 barato.
  # 30-jul: SE QUITA LA LISTA A MANO. Era `^(guard|visor|topbar|totales|consent)`
  # y el fallo cayo tres veces seguidas, siempre en el fichero que faltaba en la
  # lista: guard.js (29-jul, agentes sin permisos), consent.js (29-jul, pixel de
  # Meta) y entities.js (30-jul, las facturas de PT San Dal Woods salian con el
  # logo de Lawang porque el navegador tenia la version sin el campo `logo`).
  # Una lista de nombres a mano ES el bug: el proximo fichero nuevo tampoco
  # estara. Ahora entra TODO el js/css del sitio.
  # Coste real: una revalidacion por fichero en visita repetida, que responde
  # 304 sin cuerpo. Las imagenes y los videos -- lo que de verdad pesa -- siguen
  # con su cache de 7 dias intacta.
  # HTML DE LA SUITE INTERNA -- 15-ago-2026.
  # El sellado `?v=<hash>` de los assets vive DENTRO del HTML: si el navegador
  # cachea la pagina, sirve referencias viejas y el sellado no sirve de nada. Es
  # la misma familia del incidente de guard.js (29-jul), un piso mas arriba. Paso
  # de verdad: el owner no veia el menu lateral nuevo porque su navegador le
  # servia un HTML sin la etiqueta del catalogo.
  #
  # Se acota por RUTA y no por nombre de fichero: un <FilesMatch "index.html">
  # habria casado tambien con el index.html PUBLICO de la raiz, y ahi cada visita
  # revalidaria sin motivo -- son paginas de marketing que cambian poco.
  # `no-cache` no desactiva la cache: obliga a revalidar, asi que si no ha
  # cambiado responde 304 sin cuerpo.
  SetEnvIf Request_URI "^/(intranet|operaciones|facturas|compradores|proyectos|documentacion|obra|usuarios|creatividades|dossier|contracts|entrar|portal)/" LW_SUITE
  Header set Cache-Control "no-cache, must-revalidate" env=LW_SUITE
  Header unset Expires env=LW_SUITE

  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
    # el servidor emite ademas un Expires a 7 dias. Cache-Control manda sobre
    # Expires por norma, asi que no rompe nada, pero deja unas cabeceras que se
    # contradicen: quien diagnostique el proximo problema de cache las leera y
    # perdera el tiempo. Fuera.
    Header unset Expires
  </FilesMatch>
</IfModule>
